LLM_PROVIDER=mock            # mock | anthropic | openrouter (OpenRouter: set OPENROUTER_API_KEY and LLM_MODEL=anthropic/claude-haiku-5.5)
LLM_MODEL=claude-haiku-5-5   # or claude-sonnet-5-5 for stronger reasoning
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_S=20
LLM_EFFORT=low               # low | medium | high (Claude output_config.effort)
ORS_API_KEY=                 # only for scripts/build_road_graph.py
WEATHER_MODE=cache           # live | cache
SIM_SPEED=120                # sim seconds per real second
APPROVAL_THRESHOLD_KG=6000
SEED=42
DEMO_INJECT_FAULT=false      # true: corrupt exactly one coordinator plan per demo run (see docs/03)
JWT_SECRET=                  # empty: random secret kept in backend/.jwt_secret (git-ignored); set it in production
DATABASE_URL=                # optional Postgres for run history (runs, decision log, cycles, AI conversations); empty = memory only
